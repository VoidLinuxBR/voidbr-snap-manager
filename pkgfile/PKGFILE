pkgname=voidbr-snapper-manager
pkgdesc="Snapshots btrfs+snapper automáticos no xbps (hooks pre/post) e restauração trocando o @"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=(voidbr-snap-manager)  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=(voidbr-snap-manager)  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=(voidbr-snap-manager) # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	'bash'
	'snapper'
	'btrfs-progs'
	'grub-btrfs'
	'util-linux'
	'coreutils'
	'voidbr-xbps'
	'polkit'
	'python3-gobject'
	'gtk4'
)

backup=(
	'/etc/voidbr-snapper-manager.conf'
)

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
	echo "==> voidbr-snapper-manager instalado."
	echo "    O xbps agora cria um snapshot pre/post a cada transação,"
	echo "    se o / for btrfs e existir a config 'root' do snapper."
	echo "    Para configurar: sudo voidbr-snapper-manager setup"
	echo "    No Hyprland, adicione ao hyprland.conf:"
	echo "      exec-once = voidbr-snapper-manager check --notify"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
