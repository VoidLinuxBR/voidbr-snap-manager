#!/usr/bin/env bash
#
# voidbr-snapper-manager - snapshots btrfs + snapper integrados ao xbps (VoidBR)
#
# Layout suportado (flat, estilo Arch Wiki):
#   @ (raiz)  @home  @snapshots   com o / montado por subvol=@
#
# Nesse layout o "snapper rollback" não tem efeito, porque o fstab e o
# bootloader montam o / pelo nome @. O restore deste script troca o @
# pelo snapshot escolhido e transforma o @ antigo num snapshot comum do
# snapper (como faz o openSUSE), que depois é apagado pelas regras de
# limpeza do próprio snapper (NUMBER_LIMIT).
#
# Subcomandos:
#   pre                chamado pelo hook PreTransaction do voidbr-xbps
#   post               chamado pelo hook PostTransaction do voidbr-xbps
#   list               lista os snapshots
#   diff [N]           mostra o que mudou entre o pre N e o post dele
#   restore [N]        troca o @ pelo snapshot N (sem N: o snapshot atual)
#   check [--notify]   avisa se o sistema foi bootado num snapshot
#   setup              cria a config do snapper no layout certo e libera o wheel
#   migrate [finish]   converte o / da raiz do btrfs para o layout @/@home/@snapshots
#   limine-entries     gera o submenu de snapshots do Limine (chamado pelo update-limine)
#   limine-refresh     refaz o menu do Limine (usado pelo cron diário)
#   schedule [...]     snapshots periódicos (timeline do snapper, via cronie)
#

set -uo pipefail

readonly app="voidbr-snapper-manager"
readonly conf_file="/etc/$app.conf"
readonly state_dir="/run/$app"
readonly state_pre="$state_dir/pre"

# padrões (podem ser alterados em /etc/voidbr-snapper-manager.conf)
snapper_config="root"
root_subvol="@"
home_subvol="@home"
snap_subvol="@snapshots"
abort_on_fail="no"
important_pkgs="linux* glibc xbps voidbr-xbps grub* limine*"
desc_max=120
snapshots_dir="/.snapshots"
limine_dest="/boot/efi/limine"
limine_prefix="/limine"
limine_max_snapshots=10
limine_esp_reserve_mb=8
schedule_default="daily 7"

# shellcheck source=/dev/null
[[ -r $conf_file ]] && . "$conf_file"

red='\e[1;31m'
green='\e[1;32m'
yellow='\e[1;33m'
blue='\e[1;34m'
cyan='\e[1;36m'
bold='\e[1m'
dim='\e[2m'
reset='\e[0m'

msg() { printf '%b==>%b %s\n' "$blue" "$reset" "$*"; }
ok() { printf '%b==>%b %s\n' "$green" "$reset" "$*"; }
warn() { printf '%b==> AVISO:%b %s\n' "$yellow" "$reset" "$*" >&2; }
die() {
	printf '%b==> ERRO:%b %s\n' "$red" "$reset" "$*" >&2
	exit 1
}

assume_yes=no

confirm() {
	local resp
	[[ $assume_yes == yes ]] && return 0
	read -rp "$1 [s/N] " resp
	[[ ${resp,,} == s* ]]
}

# Usa o snapperd (dbus) quando ele está disponível: com --no-dbus, um
# snapperd rodando não fica sabendo das mudanças e continua mostrando a
# lista antiga (a GUI consulta pelo snapperd). --no-dbus só fica de reserva
# para quando não há dbus/snapperd (chroot, instalador).
snap_mode=""
snap() {
	if [[ -z $snap_mode ]]; then
		if snapper -c "$snapper_config" get-config >/dev/null 2>&1; then
			snap_mode=dbus
		else
			snap_mode=nodbus
		fi
	fi
	if [[ $snap_mode == dbus ]]; then
		snapper -c "$snapper_config" "$@"
	else
		snapper --no-dbus -c "$snapper_config" "$@"
	fi
}

# faz o snapperd reler configs e snapshots alterados fora dele
snapperd_reload() {
	[[ -e /var/service/snapperd ]] && sv restart snapperd >/dev/null 2>&1
	snap_mode=""
	return 0
}

#-------------------------------------------------------------------------
# detecção do ambiente
#-------------------------------------------------------------------------

is_btrfs() { [[ $(findmnt -no FSTYPE / 2>/dev/null) == btrfs ]]; }
root_dev() { findmnt -no SOURCE / | sed 's/\[.*//'; }
root_fsroot() { findmnt -no FSROOT /; }
has_config() { [[ -f /etc/snapper/configs/$snapper_config ]]; }
in_snapshot() { [[ $(root_fsroot) == "/$snap_subvol/"*/snapshot ]]; }

# número do snapshot em que o sistema foi bootado (vazio se não estiver num)
current_snap_num() {
	local fsroot
	fsroot=$(root_fsroot)
	[[ $fsroot =~ ^/${snap_subvol}/([0-9]+)/snapshot$ ]] && echo "${BASH_REMATCH[1]}"
}

check_root() {
	((EUID == 0)) || die "rode como root: sudo $app $*"
}

#-------------------------------------------------------------------------
# topo do btrfs (subvolid=5), onde ficam @, @home e @snapshots
#-------------------------------------------------------------------------

top=""

umount_top() {
	if [[ -n $top ]] && mountpoint -q "$top"; then
		umount "$top" && rmdir "$top"
	fi
	top=""
}
trap umount_top EXIT

mount_top() {
	top=$(mktemp -d "/tmp/$app.XXXXXX") || die "falha ao criar ponto de montagem"
	mount -o subvolid=5 "$(root_dev)" "$top" || die "falha ao montar o topo do btrfs"
	[[ -d $top/$root_subvol && -d $top/$snap_subvol ]] ||
		die "não encontrei $root_subvol e $snap_subvol no topo do btrfs"
}

snap_desc() {
	sed -n 's:.*<description>\(.*\)</description>.*:\1:p' \
		"$top/$snap_subvol/$1/info.xml" 2>/dev/null
}

#-------------------------------------------------------------------------
# pre / post (hooks do voidbr-xbps)
#
# Um hook PreTransaction que sai com erro ABORTA a transação no
# voidbr-xbps. Por isso qualquer situação em que não dê para tirar o
# snapshot termina com 0, exceto se abort_on_fail=yes.
#-------------------------------------------------------------------------

hook_skip() {
	warn "snapshot não criado: $*"
	exit 0
}

hook_fail() {
	warn "falha ao criar snapshot: $*"
	[[ $abort_on_fail == yes ]] && {
		warn "abortando a transação (abort_on_fail=yes)"
		exit 1
	}
	exit 0
}

# lê os pacotes enviados pelo NeedsTargets (stdin, um por linha)
read_targets() {
	targets=()
	[[ -t 0 ]] && return
	local pkg
	while IFS= read -r pkg; do
		[[ -n $pkg ]] && targets+=("$pkg")
	done
}

build_desc() {
	local desc="xbps: ${targets[*]:-transação}"
	((${#desc} > desc_max)) && desc="${desc:0:desc_max-3}..."
	printf '%s' "$desc"
}

is_important() {
	local pkg pat
	for pkg in "${targets[@]}"; do
		for pat in $important_pkgs; do
			# shellcheck disable=SC2053
			[[ $pkg == $pat ]] && return 0
		done
	done
	return 1
}

hook_checks() {
	[[ -n ${VOIDBR_SNAPPER_SKIP:-} ]] && hook_skip "VOIDBR_SNAPPER_SKIP definido"
	((EUID == 0)) || hook_skip "não está rodando como root"
	command -v snapper >/dev/null || hook_skip "snapper não instalado"
	is_btrfs || hook_skip "o / não é btrfs"
	has_config || hook_skip "config '$snapper_config' do snapper não existe"
	in_snapshot && hook_skip "sistema bootado num snapshot"
}

cmd_pre() {
	local num userdata=()
	read_targets
	hook_checks
	is_important && userdata=(-u "important=yes")

	num=$(snap create -t pre -p -c number "${userdata[@]}" -d "$(build_desc)") ||
		hook_fail "snapper create -t pre"

	mkdir -p "$state_dir" && printf '%s\n' "$num" >"$state_pre"
	ok "snapshot pre $num criado"
}

cmd_post() {
	local pre num userdata=()
	read_targets
	hook_checks

	[[ -r $state_pre ]] || hook_skip "não há snapshot pre desta transação"
	pre=$(<"$state_pre")
	rm -f "$state_pre"
	[[ $pre =~ ^[0-9]+$ ]] || hook_skip "número do pre inválido"

	is_important && userdata=(-u "important=yes")

	num=$(snap create -t post --pre-number "$pre" -p -c number "${userdata[@]}" -d "$(build_desc)") ||
		hook_fail "snapper create -t post"

	ok "snapshot post $num criado (par do $pre)"
	limine_refresh
}

#-------------------------------------------------------------------------
# Limine
#
# O Limine só lê FAT (a ESP), não lê btrfs. Por isso o kernel/initramfs
# de cada snapshot precisa estar na ESP. O update-limine gera o
# limine.conf inteiro e chama "voidbr-snapper-manager limine-entries"
# para incluir o submenu de snapshots.
#
# Para economizar a ESP, cada snapshot reaproveita o kernel/initramfs que
# o update-limine já copiou para $limine_dest quando a versão é a mesma.
# Só snapshots com kernel que não existe mais no sistema recebem cópia
# própria, em $limine_dest/snapshots/ (deduplicada por hash), e só se
# couber na ESP.
#-------------------------------------------------------------------------

has_limine() {
	command -v update-limine >/dev/null && [[ -f $limine_dest/limine.conf ]]
}

has_grub() {
	command -v grub-mkconfig >/dev/null && [[ -f /boot/grub/grub.cfg ]]
}

# o update-limine instalado já tem suporte a rootflags e ao submenu?
limine_patched() {
	grep -q "$app limine-entries" "$(command -v update-limine)" 2>/dev/null
}

# regenera o limine.conf (kernels + submenu de snapshots)
limine_refresh() {
	has_limine || return 0
	if ! limine_patched; then
		warn "o update-limine instalado não gera o submenu de snapshots (versão antiga)"
		return 0
	fi
	update-limine >/dev/null 2>&1 || warn "falha ao atualizar o menu do Limine (update-limine)"
}

# kernel mais novo dentro de um /boot: imprime a versão
newest_kernel_in() {
	local f v best=""
	for f in "$1"/vmlinuz-*; do
		[[ -f $f ]] || continue
		v=${f##*/vmlinuz-}
		best=$(printf '%s\n%s\n' "$best" "$v" | sed '/^$/d' | sort -V | tail -n1)
	done
	printf '%s' "$best"
}

lim_used=()
lim_ref=""

# acha (ou copia) na ESP um arquivo do snapshot; resultado em $lim_ref
# $1 = arquivo no snapshot   $2 = nome na ESP (ex: vmlinuz-6.6.30_1)
# $3 = "reuse" para aceitar a cópia principal mesmo com conteúdo diferente
lim_file() {
	local src=$1 main=$2 mode=${3:-} dest=$lim_dest sdir="$lim_dest/snapshots" h name need avail
	lim_ref=""
	if [[ -f $dest/$main ]] && { cmp -s "$src" "$dest/$main" || [[ $mode == reuse ]]; }; then
		lim_ref="$lim_prefix/$main"
		return 0
	fi
	h=$(sha256sum "$src" | cut -c1-12)
	name="$h-$main"
	if [[ ! -f $sdir/$name ]]; then
		need=$(stat -c%s "$src")
		avail=$(df --output=avail -B1 "$dest" | tail -n1 | tr -d ' ')
		[[ $avail =~ ^[0-9]+$ ]] || return 1
		((avail - need > limine_esp_reserve_mb * 1024 * 1024)) || return 1
		mkdir -p "$sdir"
		if ! { cp "$src" "$sdir/$name.tmp" && mv "$sdir/$name.tmp" "$sdir/$name"; }; then
			rm -f "$sdir/$name.tmp"
			return 1
		fi
	fi
	lim_used+=("$name")
	lim_ref="$lim_prefix/snapshots/$name"
}

xml_tag() {
	sed -n "s:.*<$1>\(.*\)</$1>.*:\1:p" "$2" 2>/dev/null | head -n1
}

# gera o submenu na saída padrão (mensagens vão para stderr)
# $1 = UUID do /   $2 = cmdline   [$3 = prefixo boot()]   [$4 = pasta na ESP]
cmd_limine_entries() {
	local uuid=${1:-} cmdline=${2:-} n snap info boot ver kref iref count=0 f
	local date desc stype label body=""
	lim_prefix=${3:-$limine_prefix}
	lim_dest=${4:-$limine_dest}
	lim_used=()

	[[ -n $uuid ]] || die "uso: $app limine-entries UUID \"CMDLINE\" [PREFIXO] [PASTA_ESP]"
	[[ -d $snapshots_dir ]] || return 0

	while read -r n; do
		((count >= limine_max_snapshots)) && break
		snap="$snapshots_dir/$n/snapshot"
		info="$snapshots_dir/$n/info.xml"
		boot="$snap/boot"
		[[ -r $info && -d $boot ]] || continue

		ver=$(newest_kernel_in "$boot")
		[[ -n $ver && -f $boot/initramfs-$ver.img ]] || continue

		if ! lim_file "$boot/vmlinuz-$ver" "vmlinuz-$ver"; then
			warn "snapshot $n: sem espaço na ESP para o kernel $ver, fora do menu"
			continue
		fi
		kref=$lim_ref
		if ! lim_file "$boot/initramfs-$ver.img" "initramfs-$ver.img" &&
			! lim_file "$boot/initramfs-$ver.img" "initramfs-$ver.img" reuse; then
			warn "snapshot $n: sem espaço na ESP para o initramfs $ver, fora do menu"
			continue
		fi
		iref=$lim_ref

		date=$(xml_tag date "$info")
		desc=$(xml_tag description "$info")
		stype=$(xml_tag type "$info")
		label="#$n  ${date%:*}  ${desc:-$stype}"

		body+="//$label"$'\n'
		body+="    PROTOCOL: linux"$'\n'
		body+="    PATH: boot():$kref"$'\n'
		body+="    MODULE_PATH: boot():$iref"$'\n'
		body+="    CMDLINE: root=UUID=$uuid $cmdline rootflags=subvol=$snap_subvol/$n/snapshot"$'\n'
		body+="    COMMENT: snapshot $n ($stype), kernel $ver"$'\n'
		body+=$'\n'
		((count++))
	done < <(find "$snapshots_dir" -mindepth 1 -maxdepth 1 -regex '.*/[0-9]+' -printf '%f\n' | sort -rn)

	# apaga da ESP as cópias de snapshots que não existem mais
	for f in "$lim_dest"/snapshots/*; do
		[[ -f $f ]] || continue
		[[ " ${lim_used[*]} " == *" ${f##*/} "* ]] || rm -f "$f"
	done

	((count > 0)) || return 0
	printf '/Snapshots do sistema\n'
	printf '%s' "$body"
}

#-------------------------------------------------------------------------
# list / diff
#-------------------------------------------------------------------------

# roda o snapper para consulta: como root sem dbus; como usuário via
# snapperd, que exige ALLOW_USERS/ALLOW_GROUPS na config
snap_query() {
	local out rc
	if ((EUID == 0)); then
		out=$(snap "$@" 2>&1)
	else
		out=$(snapper -c "$snapper_config" "$@" 2>&1)
	fi
	rc=$?
	if ((rc != 0)); then
		printf '%s\n' "$out" >&2
		((EUID == 0)) ||
			warn "sem permissão? rode com sudo, ou libere o grupo wheel com: sudo $app setup"
		exit "$rc"
	fi
	printf '%s\n' "$out"
}

cmd_list() {
	snap_query list
}

# número, tipo e pre-number de cada snapshot, em CSV
snap_csv() {
	snap_query --csvout --no-headers list --columns number,type,pre-number
}

cmd_diff() {
	local pre=${1:-} post csv
	csv=$(snap_csv) || exit 1

	[[ -n $pre ]] || pre=$(awk -F, '$2 == "pre" { n = $1 } END { print n }' <<<"$csv")
	[[ -n $pre ]] || die "nenhum snapshot pre encontrado"
	[[ $pre =~ ^[0-9]+$ ]] || die "número inválido: $pre"

	post=$(awk -F, -v p="$pre" '$2 == "post" && $3 == p { print $1 }' <<<"$csv")
	[[ -n $post ]] || die "o snapshot $pre não é um pre com post correspondente"

	msg "mudanças entre $pre e $post"
	snap_query status "$pre..$post"
}

# saída para a GUI: número,tipo,pre,data(ISO),limpeza,descrição,userdata
cmd_list_csv() {
	snap_query --csvout --iso list --columns number,type,pre-number,date,cleanup,description,userdata
}

cmd_create() {
	local desc=${1:-manual} num
	check_root create
	{ is_btrfs && has_config; } || die "snapper não configurado. Rode: sudo $app setup"
	in_snapshot && die "o sistema foi iniciado num snapshot; não dá para criar snapshots aqui"
	num=$(snap create -t single -p -c number -d "$desc") || die "falha ao criar o snapshot"
	ok "snapshot $num criado"
	limine_refresh
	echo "$num"
}

cmd_delete() {
	local n cur
	check_root delete
	(($# > 0)) || die "informe o(s) número(s): $app delete N [N...]"
	cur=$(current_snap_num)
	for n in "$@"; do
		[[ $n =~ ^[0-9]+$ ]] || die "número inválido: $n"
		((n == 0)) && die "o snapshot 0 é o sistema atual"
		[[ $n == "$cur" ]] && die "o sistema está rodando no snapshot $n"
	done
	snap delete "$@" || die "falha ao apagar"
	ok "apagado(s): $*"
	limine_refresh
}

# estado do sistema, uma chave=valor por linha (usado pela GUI)
cmd_status() {
	local fsroot layout cfg=no wheel=no gb=missing hooks=no migrate=no used size bl="" sched=off

	if is_btrfs; then
		fsroot=$(root_fsroot)
		case $fsroot in
		/) layout=toplevel ;;
		"/$root_subvol") layout=flat ;;
		"/$snap_subvol/"*/snapshot) layout=snapshot ;;
		*) layout=other ;;
		esac
	else
		fsroot=""
		layout=nobtrfs
	fi

	if has_config; then
		cfg=yes
		sched=$(schedule_summary)
		grep -Eq '^ALLOW_GROUPS=".*\bwheel\b.*"' "/etc/snapper/configs/$snapper_config" && wheel=yes
	fi

	if [[ -d /etc/sv/grub-btrfs ]]; then
		[[ -e /var/service/grub-btrfs ]] && gb=active || gb=inactive
	fi

	[[ -f /etc/xbps.d/hooks.d/00-voidbr-snapper-pre.hook &&
		-f /etc/xbps.d/hooks.d/99-voidbr-snapper-post.hook ]] && hooks=yes

	[[ -f /$migrate_mark ]] && migrate=pending

	has_grub && bl=grub
	has_limine && bl=${bl:+$bl+}limine

	read -r used size < <(df -h --output=used,size / | tail -n1)

	cat <<-EOF
		layout=$layout
		fsroot=$fsroot
		booted_snapshot=$(current_snap_num)
		config=$cfg
		wheel=$wheel
		grub_btrfs=$gb
		hooks=$hooks
		migrate=$migrate
		bootloader=${bl:-unknown}
		cron=$(cron_state)
		schedule=$sched
		disk_used=$used
		disk_size=$size
	EOF
}

#-------------------------------------------------------------------------
# schedule
#
# Snapshots periódicos = "timeline" do snapper. Quem executa é o
# /etc/cron.hourly/snapper (do pacote snapper), rodado pelo cronie: ele cria
# um snapshot por hora e, na limpeza, guarda só a quantidade definida por
# período (TIMELINE_LIMIT_*). O mesmo cron faz a limpeza "number" dos
# snapshots pre/post; sem o cronie, nada é apagado.
#-------------------------------------------------------------------------

readonly schedule_mark="var/lib/$app/schedule-set"

cfg_get() {
	sed -n "s/^$1=\"\\(.*\\)\"/\\1/p" "/etc/snapper/configs/$snapper_config" 2>/dev/null
}

# resumo do agendamento: off | hourly:N,daily:N,...
schedule_summary() {
	local p v out=""
	[[ $(cfg_get TIMELINE_CREATE) == yes ]] || {
		echo off
		return
	}
	for p in hourly daily weekly monthly yearly; do
		v=$(cfg_get "TIMELINE_LIMIT_${p^^}")
		[[ $v =~ ^[0-9]+$ ]] && ((v > 0)) && out+="${out:+,}$p:$v"
	done
	echo "${out:-off}"
}

cron_state() {
	if [[ -e /var/service/cronie ]]; then
		echo active
	elif [[ -d /etc/sv/cronie ]]; then
		echo inactive
	else
		echo missing
	fi
}

# schedule off | schedule daily 7 [weekly 4 ...]
schedule_apply() {
	local -a sets=("NUMBER_CLEANUP=yes" "TIMELINE_CLEANUP=yes" "EMPTY_PRE_POST_CLEANUP=yes")
	local p n
	declare -A lim=([hourly]=0 [daily]=0 [weekly]=0 [monthly]=0 [yearly]=0)

	if [[ ${1:-} == off ]]; then
		sets+=("TIMELINE_CREATE=no")
	else
		(($# > 0 && $# % 2 == 0)) || die "uso: $app schedule off | hourly|daily|weekly|monthly|yearly N [...]"
		while (($#)); do
			p=$1 n=$2
			shift 2
			[[ -v "lim[$p]" ]] || die "período inválido: $p (use hourly, daily, weekly, monthly ou yearly)"
			[[ $n =~ ^[0-9]+$ ]] || die "quantidade inválida: $n"
			lim[$p]=$n
		done
		sets+=("TIMELINE_CREATE=yes")
		for p in hourly daily weekly monthly yearly; do
			sets+=("TIMELINE_LIMIT_${p^^}=${lim[$p]}")
		done
	fi
	snap set-config "${sets[@]}" || die "falha ao alterar a config do snapper"
}

cmd_schedule() {
	local sum
	if [[ -z ${1:-} || ${1:-} == show ]]; then
		has_config || die "snapper não configurado. Rode: sudo $app setup"
		sum=$(schedule_summary)
		msg "agendamento: ${sum//,/, }"
		msg "cronie: $(cron_state)"
		[[ $(cron_state) == active ]] ||
			warn "sem o cronie ativo, não há snapshots periódicos nem limpeza automática"
		return 0
	fi
	check_root schedule
	has_config || die "snapper não configurado. Rode: sudo $app setup"
	schedule_apply "$@"
	mkdir -p "/${schedule_mark%/*}" && : >"/$schedule_mark"
	ok "agendamento: $(schedule_summary | sed 's/,/, /g')"
	[[ $(cron_state) == active ]] ||
		warn "o cronie não está ativo; rode: sudo $app setup"
}

cmd_limine_refresh() {
	check_root limine-refresh
	limine_refresh
}

#-------------------------------------------------------------------------
# setup
#
# O "snapper create-config /" sempre cria um subvolume .snapshots dentro
# do @. No layout flat, esse subvolume é apagado e o @snapshots volta a
# ser montado em /.snapshots, pelo fstab.
#-------------------------------------------------------------------------

cmd_setup() {
	check_root setup
	command -v snapper >/dev/null || die "snapper não instalado"
	is_btrfs || die "o / não é btrfs"

	if [[ $(root_fsroot) == / ]]; then
		die "o / está direto na raiz do btrfs, sem subvolumes. Converta antes com: sudo $app migrate"
	fi
	[[ $(root_fsroot) == "/$root_subvol" ]] ||
		die "o / não está no subvolume $root_subvol (atual: $(root_fsroot)). Layout não suportado."

	mount_top
	[[ -d $top/$snap_subvol ]] || die "o subvolume $snap_subvol não existe no topo do btrfs"
	umount_top

	grep -Eq "[[:space:]]/\.snapshots[[:space:]].*subvol=/?$snap_subvol([,[:space:]]|$)" /etc/fstab ||
		die "o fstab não monta o $snap_subvol em /.snapshots"

	# 1. config do snapper
	if has_config; then
		ok "config '$snapper_config' do snapper já existe"
	else
		msg "criando a config '$snapper_config' do snapper"
		mountpoint -q /.snapshots && { umount /.snapshots || die "falha ao desmontar /.snapshots"; }
		[[ -d /.snapshots ]] && { rmdir /.snapshots || die "/.snapshots não está vazio"; }

		snapper --no-dbus -c "$snapper_config" create-config / ||
			die "falha no snapper create-config"

		btrfs subvolume delete /.snapshots >/dev/null ||
			die "falha ao apagar o /.snapshots criado pelo snapper"
		mkdir /.snapshots
		mount /.snapshots || die "falha ao montar o $snap_subvol em /.snapshots"
		chmod 750 /.snapshots
		snapperd_reload
		ok "config criada, com o $snap_subvol em /.snapshots"
	fi

	# 2. grupo wheel pode consultar (list/diff sem sudo)
	snap set-config "ALLOW_GROUPS=wheel" "SYNC_ACL=yes" ||
		warn "não consegui liberar o grupo wheel na config"
	ok "grupo wheel liberado para consultar os snapshots"

	# 2b. cronie: executa o /etc/cron.hourly/snapper (timeline + limpeza)
	case $(cron_state) in
	active) ok "serviço cronie já ativo" ;;
	inactive) ln -s /etc/sv/cronie /var/service/ && ok "serviço cronie ativado" ;;
	missing) warn "cronie não instalado: sem snapshots periódicos nem limpeza automática" ;;
	esac

	# 2c. agendamento padrão, só na primeira vez (não sobrescreve o do usuário)
	if [[ ! -f /$schedule_mark ]]; then
		# shellcheck disable=SC2086
		schedule_apply $schedule_default
		mkdir -p "/${schedule_mark%/*}" && : >"/$schedule_mark"
		ok "agendamento padrão: $(schedule_summary | sed 's/,/, /g')"
	else
		snap set-config "NUMBER_CLEANUP=yes" "TIMELINE_CLEANUP=yes" "EMPTY_PRE_POST_CLEANUP=yes" ||
			warn "não consegui ativar a limpeza automática"
		ok "agendamento: $(schedule_summary | sed 's/,/, /g')"
	fi

	# 3. serviço do grub-btrfs (atualiza o menu a cada snapshot), só com GRUB
	if ! has_grub; then
		:
	elif [[ -d /etc/sv/grub-btrfs ]]; then
		if [[ -e /var/service/grub-btrfs ]]; then
			ok "serviço grub-btrfs já ativo"
		else
			ln -s /etc/sv/grub-btrfs /var/service/ && ok "serviço grub-btrfs ativado"
		fi
	else
		warn "serviço grub-btrfs não encontrado em /etc/sv (pacote grub-btrfs instalado?)"
	fi

	# 4. menu do Limine
	if has_limine; then
		if limine_patched; then
			msg "atualizando o menu do Limine"
			limine_refresh && ok "menu do Limine atualizado"
		else
			warn "o update-limine instalado não tem suporte a snapshots; atualize-o"
		fi
	fi

	# 5. menu do GRUB
	if command -v grub-mkconfig >/dev/null && [[ -f /boot/grub/grub.cfg ]]; then
		msg "atualizando o menu do GRUB"
		if grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; then
			ok "menu do GRUB atualizado"
		else
			warn "falha no grub-mkconfig"
		fi
	fi

	echo
	snap list
}

#-------------------------------------------------------------------------
# restore
#-------------------------------------------------------------------------

# próximo número livre em @snapshots
next_snap_num() {
	local d n max=0
	for d in "$top/$snap_subvol"/*/; do
		n=${d%/}
		n=${n##*/}
		[[ $n =~ ^[0-9]+$ ]] && ((n > max)) && max=$n
	done
	echo $((max + 1))
}

# grava o info.xml no formato do snapper (data em UTC)
write_info_xml() {
	local file=$1 num=$2 desc=$3
	cat >"$file" <<-EOF
		<?xml version="1.0"?>
		<snapshot>
		  <type>single</type>
		  <num>$num</num>
		  <date>$(date -u '+%Y-%m-%d %H:%M:%S')</date>
		  <description>$desc</description>
		  <cleanup>number</cleanup>
		</snapshot>
	EOF
}

cmd_restore() {
	local n=${1:-} cur backup backup_dir src
	check_root "restore $n"
	is_btrfs || die "o / não é btrfs"

	cur=$(current_snap_num)
	[[ -z $n ]] && n=$cur
	[[ $n =~ ^[0-9]+$ ]] ||
		die "informe o número do snapshot (ou boote num snapshot pelo menu de boot): $app restore N"

	if [[ -z $cur ]]; then
		warn "você está no sistema normal ($(root_fsroot))."
		warn "o recomendado é bootar no snapshot $n pelo menu de boot e rodar daí."
		confirm "continuar mesmo assim?" || exit 1
	elif [[ $cur != "$n" ]]; then
		warn "você está no snapshot $cur, mas pediu para restaurar o $n."
		confirm "continuar mesmo assim?" || exit 1
	fi

	mount_top

	src="$top/$snap_subvol/$n/snapshot"
	[[ -d $src ]] || die "snapshot $n não existe"
	btrfs subvolume show "$src" >/dev/null 2>&1 || die "$src não é um subvolume"

	# Limine: o kernel da ESP precisa bater com os módulos do @ restaurado.
	# O update-limine copia os kernels do /boot em uso, então ou o sistema
	# está rodando no próprio snapshot, ou os kernels precisam ser os mesmos.
	if has_limine && [[ $cur != "$n" ]] &&
		[[ $(newest_kernel_in "$src/boot") != "$(newest_kernel_in /boot)" ]]; then
		die "o snapshot $n tem outro kernel ($(newest_kernel_in "$src/boot")). Com o Limine, inicie primeiro no snapshot $n pelo menu de boot e restaure de lá."
	fi

	backup=$(next_snap_num)
	backup_dir="$top/$snap_subvol/$backup"

	echo
	msg "snapshot escolhido: $n ($(snap_desc "$n"))"
	msg "o sistema atual será guardado como snapshot $backup"
	msg "ele será apagado depois pela limpeza automática do snapper"
	echo
	confirm "restaurar o sistema para o snapshot $n?" || exit 1

	# 1. o @ atual vira o snapshot $backup
	mkdir "$backup_dir" || die "falha ao criar $backup_dir"
	if ! mv "$top/$root_subvol" "$backup_dir/snapshot"; then
		rmdir "$backup_dir"
		die "falha ao mover o $root_subvol, nada foi alterado"
	fi

	# 2. novo @ a partir do snapshot escolhido
	if ! btrfs subvolume snapshot "$src" "$top/$root_subvol"; then
		mv "$backup_dir/snapshot" "$top/$root_subvol"
		rmdir "$backup_dir"
		die "falha ao criar o novo $root_subvol, nada foi alterado"
	fi

	# 3. registra o backup no snapper
	write_info_xml "$backup_dir/info.xml" "$backup" "backup antes do restore do $n"
	# somente leitura, como os outros snapshots. Não dá para fazer isso
	# rodando do sistema normal: o @ antigo ainda é o / em uso.
	if [[ -n $cur ]]; then
		btrfs property set -ts "$backup_dir/snapshot" ro true ||
			warn "não consegui marcar o snapshot $backup como somente leitura"
	fi

	# 4. desfaz um "snapper rollback" que tenha sido rodado antes
	btrfs subvolume set-default 5 "$top"

	umount_top

	# o backup foi registrado direto no info.xml: o snapperd precisa reler
	snapperd_reload

	# Limine: recopia para a ESP os kernels do @ restaurado
	if has_limine; then
		msg "atualizando os kernels e o menu do Limine"
		limine_refresh
	fi

	echo
	ok "sistema restaurado para o snapshot $n"
	ok "o sistema anterior está guardado como snapshot $backup"
	msg "no menu de boot, escolha a entrada NORMAL (não a de snapshots)"
	echo
	[[ $assume_yes == yes ]] && return 0
	if confirm "reiniciar agora?"; then
		reboot
	fi
}

#-------------------------------------------------------------------------
# check (aviso ao bootar num snapshot)
#-------------------------------------------------------------------------

cmd_check() {
	local mode=${1:-} n marker
	is_btrfs || exit 0
	n=$(current_snap_num)
	[[ -n $n ]] || exit 0

	# avisa uma vez por sessão
	marker="${XDG_RUNTIME_DIR:-/tmp}/$app-check${mode:+-${mode#--}}"
	[[ -e $marker ]] && exit 0
	: >"$marker" 2>/dev/null

	if [[ $mode == --notify ]]; then
		command -v notify-send >/dev/null || exit 0
		notify-send -u critical -a "$app" -i dialog-warning \
			"Sistema iniciado num snapshot ($n)" \
			"Para voltar o sistema para este snapshot, abra o terminal e rode:
sudo $app restore"
		exit 0
	fi

	echo
	warn "este sistema foi iniciado a partir do snapshot $n."
	msg "para torná-lo o sistema principal: sudo $app restore"
	if [[ -t 0 ]] && confirm "restaurar agora?"; then
		sudo "$app" restore "$n"
	fi
}

#-------------------------------------------------------------------------
# migrate
#
# Converte um sistema com o / direto na raiz do btrfs (subvolid=5, sem
# subvolumes) para o layout flat: @ (raiz), @home e @snapshots.
#
#   migrate          etapa 1: cria os subvolumes, ajusta o fstab e o GRUB
#                    dentro do novo @. O sistema antigo continua intacto
#                    na raiz até a etapa 2.
#   migrate finish   etapa 2 (depois do reboot, já no @): apaga o conteúdo
#                    antigo da raiz do btrfs.
#
# Suporta só GRUB (UEFI, UEFI --removable e BIOS).
#-------------------------------------------------------------------------

readonly migrate_mark="var/lib/$app/migrated"

# ponto de montagem da ESP (vazio se não houver)
esp_dir() {
	local d
	for d in /boot/efi /efi /boot; do
		[[ $(findmnt -no FSTYPE "$d" 2>/dev/null) == vfat ]] && {
			echo "$d"
			return
		}
	done
}

# disco físico por baixo do / (atravessa LUKS/LVM)
root_disk() {
	lsblk -nspo NAME,TYPE "$(root_dev)" | awk '$2 == "disk" { d = $1 } END { print d }'
}

# ids de boot UEFI que apontam para o grubx64.efi (ex: void, Void Linux)
grub_efi_ids() {
	efibootmgr -v 2>/dev/null |
		grep -io '\\EFI\\[^\\]*\\grubx64\.efi' |
		tr '\134' '/' | cut -d/ -f3 | sort -u
}

# o fallback EFI/BOOT/BOOTX64.EFI é um GRUB?
grub_is_removable() {
	local esp=$1 f
	f=$(find "$esp" -maxdepth 3 -ipath "$esp/efi/boot/bootx64.efi" 2>/dev/null | head -n1)
	[[ -n $f ]] && grep -aqi 'grub' "$f"
}

# reescreve o fstab: subvol=@ no / e linhas novas para /home e /.snapshots
# $1 = fstab   $2 = criar linha do /home (yes/no)
migrate_fstab() {
	local fstab=$1 with_home=$2 spec opts
	read -r spec opts < <(awk '!/^[[:space:]]*#/ && $2 == "/" && $3 == "btrfs" { print $1, $4; exit }' "$fstab")
	[[ -n $spec && -n $opts ]] || return 1

	# tira subvol/subvolid que por acaso existam
	opts=$(tr ',' '\n' <<<"$opts" | grep -Ev '^subvol(id)?=' | paste -sd, -)

	# troca só o campo de opções da linha do /, mantendo o alinhamento
	sed -E "0,/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+btrfs[[:space:]]/s|^([^#[:space:]]+[[:space:]]+/[[:space:]]+btrfs[[:space:]]+)[^[:space:]]+|\1$opts,subvol=$root_subvol|" \
		"$fstab" >"$fstab.new" || return 1

	{
		[[ $with_home == yes ]] &&
			printf '%s  /home        btrfs  %s,subvol=%s  0 0\n' "$spec" "$opts" "$home_subvol"
		printf '%s  /.snapshots  btrfs  %s,subvol=%s  0 0\n' "$spec" "$opts" "$snap_subvol"
	} >>"$fstab.new"

	mv "$fstab.new" "$fstab"
}

migrate_checks() {
	local subs sw

	command -v snapper >/dev/null || die "snapper não instalado"
	is_btrfs || die "o / não é btrfs"

	[[ $(root_fsroot) == / ]] ||
		die "o / já está num subvolume ($(root_fsroot)). Nada a migrar."

	subs=$(btrfs subvolume list / 2>/dev/null)
	[[ -z $subs ]] || die "existem subvolumes na raiz do btrfs; o migrate não os copiaria:
$subs"

	[[ -e /$root_subvol || -e /$home_subvol || -e /$snap_subvol ]] &&
		die "já existe /$root_subvol, /$home_subvol ou /$snap_subvol na raiz"

	while read -r sw; do
		[[ -n $sw ]] || continue
		[[ $(findmnt -no SOURCE -T "$sw") == "$(root_dev)" ]] &&
			die "swapfile ativo no btrfs ($sw); o btrfs não tira snapshot assim. Desative com: swapoff $sw"
	done < <(swapon --show=NAME,TYPE --noheadings 2>/dev/null | awk '$2 == "file" { print $1 }')

	grep -Eq '^[^#]*[[:space:]]/\.snapshots[[:space:]]' /etc/fstab &&
		die "o fstab já tem uma linha para /.snapshots"

	if has_limine && ! limine_patched; then
		die "o update-limine instalado não tem suporte a subvolumes (rootflags); atualize-o antes de migrar"
	fi
	has_grub || has_limine || die "nenhum bootloader suportado encontrado (GRUB ou Limine)"
}

cmd_migrate() {
	local with_home=yes mode="" esp disk ids=() id new mnt m cfg lcfg
	check_root migrate

	[[ ${1:-} == finish ]] && {
		cmd_migrate_finish
		return
	}

	migrate_checks

	# /home em outra partição: fica como está
	if mountpoint -q /home && [[ $(findmnt -no SOURCE /home) != "$(root_dev)"* ]]; then
		with_home=no
	elif grep -Eq '^[^#]*[[:space:]]/home[[:space:]]' /etc/fstab; then
		die "o fstab tem uma linha para /home, mas o /home não está montado. Confira antes de migrar."
	fi

	# como o GRUB está instalado
	esp=$(esp_dir)
	if ! has_grub; then
		mode="none"
	elif [[ -d /sys/firmware/efi ]]; then
		[[ -n $esp ]] || die "sistema UEFI, mas a ESP não está montada"
		command -v efibootmgr >/dev/null || die "efibootmgr não instalado"
		while IFS= read -r id; do
			[[ -n $(find "$esp" -maxdepth 3 -ipath "$esp/efi/$id/grubx64.efi" 2>/dev/null) ]] && ids+=("$id")
		done < <(grub_efi_ids)
		grub_is_removable "$esp" && mode="removable"
		((${#ids[@]} > 0)) && mode="${mode:+$mode+}id"
		[[ -n $mode ]] || die "não achei o GRUB na ESP ($esp)"
	else
		mode="bios"
		disk=$(root_disk)
		[[ -b $disk ]] || die "não achei o disco do /"
	fi

	echo
	msg "sistema: $(root_dev), / direto na raiz do btrfs"
	msg "vai criar: $root_subvol, $snap_subvol$([[ $with_home == yes ]] && echo ", $home_subvol")"
	[[ $with_home == no ]] && msg "/home está em outra partição e fica como está"
	has_limine && msg "Limine em $limine_dest (rootflags=subvol=$root_subvol no limine.conf)"
	case $mode in
	none) ;;
	bios) msg "GRUB BIOS em $disk" ;;
	*) msg "GRUB UEFI em $esp$( ((${#ids[@]})) && echo " (id: ${ids[*]})")$([[ $mode == *removable* ]] && echo " + fallback EFI/BOOT")" ;;
	esac
	echo
	warn "tire um backup (ou snapshot da VM) antes de continuar."
	warn "o que mudar no sistema depois deste ponto e antes do reboot não vai para o novo $root_subvol."
	confirm "migrar para o layout $root_subvol/$snap_subvol?" || exit 1

	# 1. subvolumes
	msg "criando $root_subvol (snapshot da raiz)"
	btrfs subvolume snapshot / "/$root_subvol" >/dev/null || die "falha ao criar /$root_subvol"
	btrfs subvolume create "/$snap_subvol" >/dev/null || die "falha ao criar /$snap_subvol"

	# 2. /home para o @home
	if [[ $with_home == yes ]]; then
		msg "movendo /home para $home_subvol"
		btrfs subvolume create "/$home_subvol" >/dev/null || die "falha ao criar /$home_subvol"
		cp -a --reflink=always "/$root_subvol/home/." "/$home_subvol/" ||
			die "falha ao copiar o /home para /$home_subvol"
		find "/$root_subvol/home" -mindepth 1 -delete
	fi

	# 3. fstab do novo @
	new="/$root_subvol"
	mkdir -p "$new/.snapshots"
	cp -a "$new/etc/fstab" "$new/etc/fstab.pre-migrate"
	migrate_fstab "$new/etc/fstab" "$with_home" || die "falha ao ajustar o $new/etc/fstab"
	ok "fstab ajustado (original em /etc/fstab.pre-migrate)"

	# 4. Limine: o limine.conf atual passa a montar o @
	#    (os kernels na ESP são os mesmos; o update-limine novo mantém o
	#    rootflags nas próximas atualizações de kernel)
	if has_limine; then
		lcfg="$limine_dest/limine.conf"
		cp -a "$lcfg" "$lcfg.pre-migrate"
		sed -i -E "/^[[:space:]]*CMDLINE:/I{/rootflags=/!s/[[:space:]]+single[[:space:]]*\$/ rootflags=subvol=$root_subvol single/;/rootflags=/!s/[[:space:]]*\$/ rootflags=subvol=$root_subvol/}" "$lcfg"
		if grep -Eiq '^[[:space:]]*CMDLINE:' "$lcfg" &&
			! grep -Ei '^[[:space:]]*CMDLINE:' "$lcfg" | grep -vq "rootflags=subvol=$root_subvol"; then
			ok "Limine ajustado (original em $lcfg.pre-migrate)"
		else
			cp -a "$lcfg.pre-migrate" "$lcfg"
			die "falha ao ajustar o $lcfg. Nada no boot foi alterado; o $root_subvol criado pode ser apagado."
		fi
	fi

	# 5. GRUB dentro do novo @
	mnt=$(mktemp -d "/tmp/$app-migrate.XXXXXX")
	mount -o "subvol=$root_subvol" "$(root_dev)" "$mnt" || die "falha ao montar o $root_subvol"

	if [[ $mode != none ]]; then
		for m in /boot /boot/efi /efi; do
			mountpoint -q "$m" && mount --bind "$m" "$mnt$m"
		done
		for m in dev proc sys run; do
			mount --rbind "/$m" "$mnt/$m" && mount --make-rslave "$mnt/$m"
		done

		msg "instalando o GRUB no novo $root_subvol"
		if [[ $mode == bios ]]; then
			chroot "$mnt" grub-install --target=i386-pc "$disk" || {
				umount -R "$mnt"
				die "falha no grub-install"
			}
		else
			for id in "${ids[@]}"; do
				chroot "$mnt" grub-install --target=x86_64-efi --efi-directory="$esp" \
					--bootloader-id="$id" || {
					umount -R "$mnt"
					die "falha no grub-install ($id)"
				}
			done
			if [[ $mode == *removable* ]]; then
				chroot "$mnt" grub-install --target=x86_64-efi --efi-directory="$esp" \
					--removable || {
					umount -R "$mnt"
					die "falha no grub-install --removable"
				}
			fi
		fi

		chroot "$mnt" grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 ||
			{
				umount -R "$mnt"
				die "falha no grub-mkconfig"
			}

		cfg="$mnt/boot/grub/grub.cfg"
		if ! grep -q "rootflags=subvol=$root_subvol" "$cfg"; then
			umount -R "$mnt"
			die "o grub.cfg novo não tem rootflags=subvol=$root_subvol. NÃO reinicie: restaure o backup."
		fi
		ok "GRUB instalado, com rootflags=subvol=$root_subvol"
	fi

	mkdir -p "$mnt/${migrate_mark%/*}"
	date '+%F %T' >"$mnt/$migrate_mark"
	umount -R "$mnt" && rmdir "$mnt"

	echo
	ok "etapa 1 concluída"
	msg "depois do reboot, confira com: findmnt -no FSROOT /   (tem que ser /$root_subvol)"
	msg "e termine com: sudo $app migrate finish"
	echo
	if confirm "reiniciar agora?"; then
		reboot
	fi
}

cmd_migrate_finish() {
	local e n=0 entries=()

	[[ $(root_fsroot) == "/$root_subvol" ]] ||
		die "o sistema não subiu no $root_subvol (atual: $(root_fsroot)). Rode o finish só depois do reboot."
	[[ -f /$migrate_mark ]] || die "não há migração pendente (/$migrate_mark não existe)"

	mount_top

	for e in "$top"/* "$top"/.[!.]*; do
		[[ -e $e ]] || continue
		case ${e##*/} in
		"$root_subvol" | "$home_subvol" | "$snap_subvol") continue ;;
		esac
		entries+=("$e")
	done

	if ((${#entries[@]} == 0)); then
		ok "a raiz do btrfs já está limpa"
	else
		msg "conteúdo antigo na raiz do btrfs (fora de $root_subvol/$home_subvol/$snap_subvol):"
		printf '    %s\n' "${entries[@]##*/}"
		echo
		warn "isso apaga o sistema antigo. O sistema atual ($root_subvol) não é afetado."
		confirm "apagar o conteúdo antigo da raiz?" || exit 1

		for e in "${entries[@]}"; do
			rm -rf --one-file-system -- "$e" && ((n++))
		done
		ok "$n itens apagados"
	fi

	umount_top
	rm -f "/$migrate_mark"

	echo
	ok "migração concluída"
	msg "próximo passo: sudo $app setup"
}

#-------------------------------------------------------------------------

usage() {
	local c_title c_cmd c_arg c_dim c_reset
	if [[ -t 1 ]]; then
		c_title="$cyan$bold" c_cmd=$green c_arg=$yellow c_dim=$dim c_reset=$reset
	else
		c_title="" c_cmd="" c_arg="" c_dim="" c_reset=""
	fi

	# alinha pelo texto puro e só depois aplica as cores
	cmdline() {
		local cmd=$1 args=$2 desc=$3 plain pad
		plain="$cmd${args:+ $args}"
		pad=$((22 - ${#plain}))
		if ((pad < 1)); then
			printf '  %b%s%b%s%b\n' "$c_cmd" "$cmd" "$c_arg" "${args:+ $args}" "$c_reset"
			printf '  %24s%s\n' "" "$desc"
		else
			printf '  %b%s%b%s%b%*s  %s\n' "$c_cmd" "$cmd" "$c_arg" "${args:+ $args}" "$c_reset" "$pad" "" "$desc"
		fi
	}
	title() { printf '\n%b%s%b\n' "$c_title" "$1" "$c_reset"; }

	printf '%bUso:%b %s %b<comando>%b [opções]\n' "$c_title" "$c_reset" "$app" "$c_arg" "$c_reset"

	title "Consulta"
	cmdline list "" "lista os snapshots"
	cmdline diff "[N]" "o que mudou na transação do pre N (padrão: a última)"
	cmdline status "" "estado do sistema (chave=valor)"
	cmdline check "[--notify]" "avisa se o sistema foi iniciado num snapshot"

	title "Snapshots"
	cmdline create "[DESCRIÇÃO]" "cria um snapshot manual"
	cmdline delete "N [N...]" "apaga snapshots"
	cmdline restore "[N]" "restaura o sistema para o snapshot N"
	printf '  %24s%b%s%b\n' "" "$c_dim" "(sem N: o snapshot em que o sistema foi iniciado)" "$c_reset"

	title "Configuração"
	cmdline setup "" "cria a config do snapper, ativa o cronie e o grub-btrfs"
	cmdline schedule "[show]" "mostra o agendamento dos snapshots periódicos"
	cmdline schedule "daily 7 [weekly 4]" "guarda N por período (hourly, daily, weekly, monthly, yearly)"
	cmdline schedule "off" "desliga os periódicos (a limpeza continua)"
	cmdline migrate "" "converte o / da raiz do btrfs para @/@home/@snapshots"
	cmdline migrate "finish" "depois do reboot: apaga o sistema antigo da raiz"

	title "Uso interno"
	cmdline pre "" "snapshot antes da transação (hook do voidbr-xbps)"
	cmdline post "" "snapshot depois da transação (hook do voidbr-xbps)"
	cmdline limine-entries 'UUID "CMDLINE"' "submenu de snapshots do Limine (update-limine)"
	cmdline limine-refresh "" "refaz o menu do Limine (cron diário)"

	title "Opções"
	cmdline --yes "" "não pergunta nada (restore não reinicia sozinho)"
	cmdline --csv "" "com list: saída em CSV (usada pela GUI)"

	title "Se uma atualização quebrar o sistema"
	printf '  %b1.%b no menu de boot, entre nos snapshots e escolha o "pre" da atualização\n' "$c_arg" "$c_reset"
	printf '  %b2.%b %bsudo %s restore%b\n' "$c_arg" "$c_reset" "$c_cmd" "$app" "$c_reset"
	printf '  %b3.%b reinicie e entre no sistema normal\n' "$c_arg" "$c_reset"

	title "Pular o snapshot numa transação"
	printf '  %bsudo VOIDBR_SNAPPER_SKIP=1 xbps-install ...%b\n' "$c_cmd" "$c_reset"
}

args=()
list_csv=no
for a in "$@"; do
	case $a in
	--yes) assume_yes=yes ;;
	--csv) list_csv=yes ;;
	*) args+=("$a") ;;
	esac
done
set -- "${args[@]}"

case ${1:-} in
pre) cmd_pre ;;
post) cmd_post ;;
list) if [[ $list_csv == yes ]]; then cmd_list_csv; else cmd_list; fi ;;
diff) cmd_diff "${2:-}" ;;
restore) cmd_restore "${2:-}" ;;
check) cmd_check "${2:-}" ;;
create)
	shift
	cmd_create "$*"
	;;
delete)
	shift
	cmd_delete "$@"
	;;
status) cmd_status ;;
setup) cmd_setup ;;
migrate) cmd_migrate "${2:-}" ;;
limine-entries)
	shift
	cmd_limine_entries "$@"
	;;
limine-refresh) cmd_limine_refresh ;;
schedule)
	shift
	cmd_schedule "$@"
	;;
*) usage ;;
esac
