# A GUI é só uma casca sobre o CLI /usr/bin/voidbr-snapper-manager:
#   - leitura (list, diff, status) roda como o usuário (grupo wheel);
#   - ações (create, delete, restore, setup) rodam via pkexec.
#

import csv
import io
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, GObject, Gtk, Pango  # noqa: E402

APP_ID = "org.voidbr.SnapperManager"
APP_NAME = "VoidBR Snapper Manager"
APP_VERSION = "0.4.0"
CLI = "/usr/bin/voidbr-snapper-manager"

TYPE_LABELS = {"single": "manual", "pre": "antes", "post": "depois"}


# ---------------------------------------------------------------------------
# execução do CLI
# ---------------------------------------------------------------------------

def run_cli(args, root=False):
    """Roda o CLI e devolve (código, stdout, stderr)."""
    cmd = (["pkexec", CLI] if root else [CLI]) + args
    try:
        p = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def run_async(args, root, callback):
    """Roda o CLI numa thread e chama callback(código, out, err) na thread da GUI."""
    def worker():
        rc, out, err = run_cli(args, root)
        GLib.idle_add(callback, rc, out, err)
    threading.Thread(target=worker, daemon=True).start()


def strip_ansi(text):
    return re.sub(r"\x1b\[[0-9;]*m", "", text)


def parse_status(text):
    st = {}
    for line in text.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            st[k.strip()] = v.strip()
    return st


# ---------------------------------------------------------------------------
# modelo
# ---------------------------------------------------------------------------

class SnapItem(GObject.Object):
    __gtype_name__ = "SnapItem"

    def __init__(self, number, stype, pre, date, cleanup, desc, userdata):
        super().__init__()
        self.number = int(number)
        self.stype = stype
        self.pre = pre
        self.date = date
        self.cleanup = cleanup
        self.desc = desc
        self.important = "important=yes" in userdata


def parse_list(text):
    items = []
    for row in csv.reader(io.StringIO(text)):
        if len(row) < 7 or not row[0].isdigit():
            continue
        if row[0] == "0":
            continue  # "current", o sistema em uso
        items.append(SnapItem(*row[:7]))
    items.sort(key=lambda i: i.number, reverse=True)
    return items


# ---------------------------------------------------------------------------
# janela principal
# ---------------------------------------------------------------------------

class MainWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME)
        self.set_default_size(980, 600)
        self.status = {}
        self.busy = False

        # cabeçalho
        header = Gtk.HeaderBar()
        self.set_titlebar(header)

        self.btn_create = self._button("list-add-symbolic", "Criar snapshot", self.on_create)
        self.btn_delete = self._button("user-trash-symbolic", "Apagar snapshot", self.on_delete)
        self.btn_diff = self._button("edit-find-symbolic", "Ver alterações", self.on_diff)
        self.btn_restore = Gtk.Button(label="Restaurar")
        self.btn_restore.add_css_class("destructive-action")
        self.btn_restore.set_tooltip_text("Voltar o sistema para o snapshot selecionado")
        self.btn_restore.connect("clicked", self.on_restore)

        for b in (self.btn_create, self.btn_delete, self.btn_diff):
            header.pack_start(b)
        header.pack_start(self.btn_restore)

        menu = Gio.Menu()
        menu.append("Configurar sistema (setup)", "win.setup")
        menu.append("Atualizar", "win.refresh")
        menu.append("Sobre", "win.about")
        menu_btn = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu)
        header.pack_end(menu_btn)

        self.spinner = Gtk.Spinner()
        header.pack_end(self.spinner)

        for name, cb in (("setup", self.on_setup), ("refresh", lambda *_: self.refresh()),
                         ("about", self.on_about)):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", cb)
            self.add_action(act)

        # corpo
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)

        # aviso: sistema iniciado num snapshot
        self.banner = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6,
                              margin_start=12, margin_end=12)
        self.banner_label = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.banner_btn = Gtk.Button(label="Restaurar este snapshot")
        self.banner_btn.add_css_class("suggested-action")
        self.banner_btn.connect("clicked", self.on_restore_current)
        self.banner.append(Gtk.Image.new_from_icon_name("dialog-warning-symbolic"))
        self.banner.append(self.banner_label)
        self.banner.append(self.banner_btn)
        self.banner.set_visible(False)
        root.append(self.banner)

        # aviso: sistema precisa de setup/migrate
        self.setup_bar = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6,
                                 margin_start=12, margin_end=12)
        self.setup_label = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.setup_btn = Gtk.Button(label="Configurar")
        self.setup_btn.add_css_class("suggested-action")
        self.setup_btn.connect("clicked", self.on_setup)
        self.setup_bar.append(Gtk.Image.new_from_icon_name("dialog-information-symbolic"))
        self.setup_bar.append(self.setup_label)
        self.setup_bar.append(self.setup_btn)
        self.setup_bar.set_visible(False)
        root.append(self.setup_bar)

        # lista de snapshots
        self.store = Gio.ListStore(item_type=SnapItem)
        self.selection = Gtk.SingleSelection(model=self.store, autoselect=False)
        self.selection.connect("notify::selected", lambda *_: self.update_buttons())

        view = Gtk.ColumnView(model=self.selection, show_row_separators=True, vexpand=True)
        view.connect("activate", lambda *_: self.on_diff())
        self._column(view, "#", lambda i: str(i.number))
        self._column(view, "Tipo", lambda i: TYPE_LABELS.get(i.stype, i.stype))
        self._column(view, "Par", lambda i: i.pre)
        self._column(view, "Data", lambda i: i.date)
        self._column(view, "Descrição", lambda i: i.desc, expand=True)
        self._column(view, "Importante", lambda i: "★" if i.important else "")

        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_child(view)
        root.append(scroll)

        # rodapé com o estado
        self.statusbar = Gtk.Label(xalign=0, margin_top=6, margin_bottom=6,
                                   margin_start=12, margin_end=12)
        self.statusbar.add_css_class("dim-label")
        root.append(Gtk.Separator())
        root.append(self.statusbar)

        self.refresh()

    # -- helpers de construção ---------------------------------------------

    def _button(self, icon, tooltip, cb):
        b = Gtk.Button(icon_name=icon, tooltip_text=tooltip)
        b.connect("clicked", cb)
        return b

    def _column(self, view, title, getter, expand=False):
        factory = Gtk.SignalListItemFactory()

        def setup(_f, li):
            lbl = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            li.set_child(lbl)

        def bind(_f, li):
            li.get_child().set_text(getter(li.get_item()))

        factory.connect("setup", setup)
        factory.connect("bind", bind)
        col = Gtk.ColumnViewColumn(title=title, factory=factory, expand=expand, resizable=True)
        view.append_column(col)

    # -- estado ------------------------------------------------------------

    def items(self):
        return [self.store.get_item(i) for i in range(self.store.get_n_items())]

    def selected(self):
        return self.selection.get_selected_item()

    def set_busy(self, busy):
        self.busy = busy
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()
        self.update_buttons()

    def update_buttons(self):
        item = self.selected()
        ready = self.status.get("config") == "yes" and not self.busy
        in_snap = bool(self.status.get("booted_snapshot"))
        self.btn_create.set_sensitive(ready and not in_snap)
        self.btn_delete.set_sensitive(ready and item is not None)
        self.btn_diff.set_sensitive(ready and item is not None and item.stype in ("pre", "post"))
        self.btn_restore.set_sensitive(ready and item is not None)

    def refresh(self):
        self.set_busy(True)
        run_async(["status"], False, self._on_status)

    def _on_status(self, rc, out, err):
        self.status = parse_status(out) if rc == 0 else {}
        self.update_banners()
        self.update_statusbar()
        if self.status.get("config") == "yes":
            run_async(["list", "--csv"], False, self._on_list)
        else:
            self.store.remove_all()
            self.set_busy(False)
        return False

    def _on_list(self, rc, out, err):
        self.store.remove_all()
        if rc != 0:
            self.set_busy(False)
            msg = strip_ansi(err).strip() or "falha ao listar os snapshots"
            if "permiss" in msg.lower():
                msg += "\n\nSeu usuário precisa estar no grupo wheel e o sistema configurado (setup)."
            self.error("Não foi possível listar os snapshots", msg)
            return False
        for item in parse_list(out):
            self.store.append(item)
        self.set_busy(False)
        return False

    def update_banners(self):
        st = self.status
        n = st.get("booted_snapshot")
        if n:
            self.banner_label.set_markup(
                f"<b>O sistema foi iniciado a partir do snapshot {n}.</b> "
                "Para torná-lo o sistema principal, restaure-o.")
        self.banner.set_visible(bool(n))

        layout = st.get("layout")
        text = None
        show_btn = True
        if layout == "nobtrfs" or not st:
            text, show_btn = "O / não está em btrfs. Os snapshots não estão disponíveis.", False
        elif layout == "toplevel":
            text = ("O / está direto na raiz do btrfs, sem subvolumes. Para usar os snapshots, "
                    "converta pelo terminal: <tt>sudo voidbr-snapper-manager migrate</tt>")
            show_btn = False
        elif layout == "other":
            text, show_btn = "Layout btrfs não suportado (esperado: @, @home, @snapshots).", False
        elif layout == "flat" and (st.get("config") != "yes" or st.get("grub_btrfs") != "active"
                                   or st.get("wheel") != "yes"):
            text = "O sistema ainda não está configurado para os snapshots."
        if text:
            self.setup_label.set_markup(text)
            self.setup_btn.set_visible(show_btn)
        self.setup_bar.set_visible(text is not None)

    def update_statusbar(self):
        st = self.status
        if not st:
            self.statusbar.set_text("não foi possível ler o estado do sistema")
            return

        def mark(ok):
            return "✓" if ok else "✗"

        gb = {"active": "ativo", "inactive": "inativo", "missing": "ausente"}.get(
            st.get("grub_btrfs", ""), "?")
        parts = [
            f"Layout: {st.get('fsroot') or '-'}",
            f"snapper {mark(st.get('config') == 'yes')}",
            f"hooks xbps {mark(st.get('hooks') == 'yes')}",
            f"grub-btrfs {gb}",
            f"Disco: {st.get('disk_used', '?')} de {st.get('disk_size', '?')}",
        ]
        self.statusbar.set_text("   •   ".join(parts))

    # -- diálogos ----------------------------------------------------------

    def error(self, title, detail=""):
        d = Gtk.AlertDialog(message=title, detail=detail, modal=True)
        d.show(self)

    def ask(self, title, detail, ok_label, callback):
        d = Gtk.AlertDialog(message=title, detail=detail, modal=True,
                            buttons=["Cancelar", ok_label], cancel_button=0, default_button=0)

        def done(dlg, res):
            try:
                if dlg.choose_finish(res) == 1:
                    callback()
            except GLib.Error:
                pass
        d.choose(self, None, done)

    def run_root(self, args, on_ok, fail_title):
        self.set_busy(True)

        def done(rc, out, err):
            self.set_busy(False)
            if rc == 0:
                on_ok(out)
            elif rc in (126, 127):
                pass  # autenticação cancelada no pkexec
            else:
                self.error(fail_title, strip_ansi(err or out).strip())
            self.refresh()
            return False
        run_async(args, True, done)

    # -- ações -------------------------------------------------------------

    def on_create(self, *_):
        dlg = Gtk.Window(title="Criar snapshot", transient_for=self, modal=True,
                         default_width=420)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=16, margin_bottom=16, margin_start=16, margin_end=16)
        box.append(Gtk.Label(label="Descrição do snapshot:", xalign=0))
        entry = Gtk.Entry(text="manual", activates_default=True)
        box.append(entry)
        btns = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancelar")
        create = Gtk.Button(label="Criar")
        create.add_css_class("suggested-action")
        btns.append(cancel)
        btns.append(create)
        box.append(btns)
        dlg.set_child(box)
        dlg.set_default_widget(create)

        cancel.connect("clicked", lambda *_: dlg.close())

        def do_create(*_):
            desc = entry.get_text().strip() or "manual"
            dlg.close()
            self.run_root(["create", desc], lambda out: None, "Falha ao criar o snapshot")
        create.connect("clicked", do_create)
        dlg.present()

    def on_delete(self, *_):
        item = self.selected()
        if not item:
            return
        nums = [str(item.number)]
        # apagar um pre/post leva o par junto
        for other in self.items():
            if item.stype == "pre" and other.stype == "post" and other.pre == str(item.number):
                nums.append(str(other.number))
            if item.stype == "post" and other.number == int(item.pre or 0):
                nums.append(str(other.number))
        nums = sorted(set(nums), key=int)
        self.ask(f"Apagar o(s) snapshot(s) {', '.join(nums)}?",
                 f"{item.desc}\n\nIsso não pode ser desfeito.", "Apagar",
                 lambda: self.run_root(["delete", *nums], lambda out: None,
                                       "Falha ao apagar"))

    def on_diff(self, *_):
        item = self.selected()
        if not item or item.stype not in ("pre", "post"):
            return
        pre = item.number if item.stype == "pre" else int(item.pre)
        self.set_busy(True)

        def done(rc, out, err):
            self.set_busy(False)
            if rc != 0:
                self.error("Não foi possível ver as alterações", strip_ansi(err).strip())
                return False
            self.show_text(f"Alterações do snapshot {pre}", strip_ansi(out))
            return False
        run_async(["diff", str(pre)], False, done)

    def show_text(self, title, text):
        win = Gtk.Window(title=title, transient_for=self, default_width=760, default_height=520)
        tv = Gtk.TextView(editable=False, monospace=True, cursor_visible=False,
                          left_margin=8, right_margin=8, top_margin=8, bottom_margin=8)
        tv.get_buffer().set_text(text)
        sw = Gtk.ScrolledWindow()
        sw.set_child(tv)
        win.set_child(sw)
        win.present()

    def on_restore(self, *_):
        item = self.selected()
        if item:
            self.confirm_restore(item.number, item.desc)

    def on_restore_current(self, *_):
        n = self.status.get("booted_snapshot")
        if n:
            desc = next((i.desc for i in self.items() if str(i.number) == n), "")
            self.confirm_restore(int(n), desc)

    def confirm_restore(self, n, desc):
        extra = ""
        if not self.status.get("booted_snapshot"):
            extra = ("\n\nRecomendado: iniciar primeiro no snapshot pelo menu do GRUB "
                     "e restaurar a partir dele.")
        self.ask(f"Restaurar o sistema para o snapshot {n}?",
                 f"{desc}\n\nO sistema atual será guardado como um novo snapshot "
                 f"(nada é apagado). Depois é preciso reiniciar.{extra}",
                 "Restaurar", lambda: self.run_root(["restore", str(n), "--yes"],
                                                    lambda out: self.ask_reboot(n),
                                                    "Falha ao restaurar"))

    def ask_reboot(self, n):
        self.ask(f"Sistema restaurado para o snapshot {n}",
                 "Reinicie e escolha a entrada NORMAL do sistema no menu de boot.",
                 "Reiniciar agora",
                 lambda: subprocess.Popen(["pkexec", "reboot"]))

    def on_setup(self, *_):
        self.run_root(["setup"], lambda out: self.show_text("Configuração", strip_ansi(out)),
                      "Falha na configuração")

    def on_about(self, *_):
        about = Gtk.AboutDialog(transient_for=self, modal=True,
                                program_name=APP_NAME, version=APP_VERSION,
                                comments="Snapshots btrfs + snapper integrados ao xbps",
                                website="https://voidbr.org",
                                authors=["Vilmar Catafesta <vcatafesta@gmail.com>"],
                                license_type=Gtk.License.MIT_X11,
                                logo_icon_name="document-revert")
        about.present()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or MainWindow(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
