"""
voidbr-snapper-manager-gui - Interface gráfica do voidbr-snapper-manager.

A GUI é só uma casca sobre o CLI /usr/bin/voidbr-snapper-manager:
  - leitura (list, diff, status) roda como o usuário (grupo wheel);
  - ações (create, delete, restore, setup) rodam via pkexec.

Requer: PyGObject (GTK4), polkit e o voidbr-snapper-manager.
    sudo xbps-install -S python3-gobject gtk4 polkit
"""

import csv
import io
import os
import re
import shutil
import subprocess
import threading

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, GObject, Gtk, Pango  # noqa: E402

APP_ID = "br.voidbr.snappermanager"
APP_NAME = "voidbr-snapper-manager"
APP_VERSION = "0.5.0"
CLI = "/usr/bin/voidbr-snapper-manager"

TIPOS = {"single": "📌 manual", "pre": "⏪ antes", "post": "⏩ depois"}

