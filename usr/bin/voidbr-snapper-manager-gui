# ---------------------------------------------------------------------------
# execução do CLI
# ---------------------------------------------------------------------------

def executar_cli(args, root=False):
    """Roda o CLI e devolve (código, stdout, stderr)."""
    comando = (["pkexec", CLI] if root else [CLI]) + args
    try:
        p = subprocess.run(comando, capture_output=True, text=True)
    except FileNotFoundError as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def executar_async(args, root, callback):
    """Roda o CLI numa thread e chama callback(código, out, err) na thread da GUI."""
    def trabalho():
        rc, out, err = executar_cli(args, root)
        GLib.idle_add(callback, rc, out, err)
    threading.Thread(target=trabalho, daemon=True).start()


def sem_ansi(texto):
    return re.sub(r"\x1b\[[0-9;]*m", "", texto)


def comando_terminal(cmd):
    """Monta o argv para abrir `cmd` (string de shell) num emulador de terminal."""
    shell = ["sh", "-c", cmd]
    preferido = os.environ.get("TERMINAL", "")
    candidatos = ([preferido] if preferido else []) + [
        "xdg-terminal-exec", "foot", "kitty", "alacritty", "wezterm",
        "xfce4-terminal", "konsole", "gnome-terminal", "xterm",
    ]
    for term in candidatos:
        caminho = shutil.which(term)
        if not caminho:
            continue
        nome = os.path.basename(caminho)
        if nome in ("xdg-terminal-exec", "foot", "kitty"):
            return [caminho, *shell]
        if nome == "wezterm":
            return [caminho, "start", "--", *shell]
        if nome == "xfce4-terminal":
            return [caminho, "-x", *shell]
        if nome == "gnome-terminal":
            return [caminho, "--", *shell]
        return [caminho, "-e", *shell]  # alacritty, konsole, xterm e outros
    return None


def ler_status(texto):
    st = {}
    for linha in texto.splitlines():
        if "=" in linha:
            k, v = linha.split("=", 1)
            st[k.strip()] = v.strip()
    return st


# ---------------------------------------------------------------------------
# modelo
# ---------------------------------------------------------------------------

class Snapshot(GObject.Object):
    __gtype_name__ = "Snapshot"

    def __init__(self, numero, tipo, pre, data, limpeza, descricao, userdata):
        super().__init__()
        self.numero = int(numero)
        self.tipo = tipo
        self.pre = pre
        self.data = data
        self.limpeza = limpeza
        self.descricao = descricao
        self.importante = "important=yes" in userdata


def ler_lista(texto):
    itens = []
    for linha in csv.reader(io.StringIO(texto)):
        if len(linha) < 7 or not linha[0].isdigit() or linha[0] == "0":
            continue  # cabeçalho ou o "current" (sistema em uso)
        itens.append(Snapshot(*linha[:7]))
    itens.sort(key=lambda i: i.numero, reverse=True)
    return itens


# ---------------------------------------------------------------------------
# janela principal
# ---------------------------------------------------------------------------

class JanelaSnapperManager(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME)
        self.set_default_size(960, 640)
        self.status = {}
        self.ocupado = False

        # --- CSS ---
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # --- Barra de título com menu ---
        cabecalho = Gtk.HeaderBar()
        cabecalho.add_css_class("cabecalho-app")
        self.set_titlebar(cabecalho)

        menu = Gio.Menu()
        menu.append("⚙️ Configurar sistema", "win.configurar")
        menu.append("🔄 Atualizar lista", "win.atualizar")
        menu.append("ℹ️ Sobre / Créditos", "win.sobre")
        botao_menu = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu)
        botao_menu.add_css_class("botao-menu")
        cabecalho.pack_end(botao_menu)

        self.spinner = Gtk.Spinner()
        cabecalho.pack_end(self.spinner)

        for nome, cb in (("configurar", self.ao_clicar_configurar),
                         ("atualizar", lambda *_: self.atualizar()),
                         ("sobre", self.ao_clicar_sobre)):
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", cb)
            self.add_action(acao)

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        self.set_child(caixa)

        # --- Título ---
        titulo = Gtk.Label(label="📸 voidbr-snapper-manager", xalign=0)
        titulo.add_css_class("titulo-app")
        caixa.append(titulo)

        # --- Aviso: sistema iniciado num snapshot ---
        self.caixa_boot = Gtk.Box(spacing=10)
        self.caixa_boot.add_css_class("caixa-alerta")
        self.label_boot = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        botao_boot = Gtk.Button(label="♻️ Restaurar este snapshot")
        botao_boot.add_css_class("botao-verde")
        botao_boot.connect("clicked", self.ao_clicar_restaurar_atual)
        self.caixa_boot.append(self.label_boot)
        self.caixa_boot.append(botao_boot)
        self.caixa_boot.set_visible(False)
        caixa.append(self.caixa_boot)

        # --- Aviso: sistema precisa de setup/migrate ---
        self.caixa_setup = Gtk.Box(spacing=10)
        self.caixa_setup.add_css_class("caixa-alerta")
        self.label_setup = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.botao_setup = Gtk.Button(label="⚙️ Configurar")
        self.botao_setup.add_css_class("botao-azul")
        self.acao_setup = self.ao_clicar_configurar
        self.botao_setup.connect("clicked", lambda *_: self.acao_setup())
        self.caixa_setup.append(self.label_setup)
        self.caixa_setup.append(self.botao_setup)
        self.caixa_setup.set_visible(False)
        caixa.append(self.caixa_setup)

        # --- Lista de snapshots ---
        rotulo = Gtk.Label(label="🗂️ Snapshots do sistema:", xalign=0)
        rotulo.add_css_class("subtitulo")
        caixa.append(rotulo)

        self.modelo = Gio.ListStore(item_type=Snapshot)
        self.selecao = Gtk.SingleSelection(model=self.modelo, autoselect=False)
        self.selecao.connect("notify::selected", lambda *_: self.atualizar_botoes())

        tabela = Gtk.ColumnView(model=self.selecao, show_row_separators=True)
        tabela.connect("activate", lambda *_: self.ao_clicar_alteracoes())
        self._coluna(tabela, "#", lambda s: str(s.numero))
        self._coluna(tabela, "Tipo", lambda s: TIPOS.get(s.tipo, s.tipo))
        self._coluna(tabela, "Par", lambda s: s.pre)
        self._coluna(tabela, "Data", lambda s: s.data)
        self._coluna(tabela, "Descrição", lambda s: s.descricao, expandir=True)
        self._coluna(tabela, "⭐", lambda s: "⭐" if s.importante else "")

        rolagem = Gtk.ScrolledWindow(vexpand=True)
        rolagem.add_css_class("lista-snapshots")
        rolagem.set_child(tabela)
        caixa.append(rolagem)

        # --- Status ---
        caixa_status = Gtk.Box()
        caixa_status.add_css_class("caixa-status")
        self.label_status = Gtk.Label(label="⏳ Carregando…", xalign=0, hexpand=True, wrap=True)
        caixa_status.append(self.label_status)
        caixa.append(caixa_status)

        # --- Ações ---
        linha_acoes = Gtk.Box(spacing=8, homogeneous=True)
        self.botao_criar = self._botao("➕ Criar snapshot", "botao-azul", self.ao_clicar_criar)
        self.botao_alteracoes = self._botao("🔍 Ver alterações", "botao-laranja",
                                            self.ao_clicar_alteracoes)
        self.botao_restaurar = self._botao("♻️ Restaurar", "botao-verde", self.ao_clicar_restaurar)
        self.botao_apagar = self._botao("🗑️ Apagar", "botao-vermelho", self.ao_clicar_apagar)
        for b in (self.botao_criar, self.botao_alteracoes, self.botao_restaurar, self.botao_apagar):
            linha_acoes.append(b)
        caixa.append(linha_acoes)

        # --- Fechar ---
        caixa.append(self._botao("🚪 Fechar", "botao-cinza", lambda *_: self.close()))

        self.atualizar()

    # -- helpers de construção ---------------------------------------------

    def _botao(self, texto, classe, cb):
        b = Gtk.Button(label=texto)
        b.add_css_class(classe)
        b.connect("clicked", cb)
        return b

    def _coluna(self, tabela, titulo, valor, expandir=False):
        fabrica = Gtk.SignalListItemFactory()

        def setup(_f, item):
            item.set_child(Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END))

        def bind(_f, item):
            item.get_child().set_text(valor(item.get_item()))

        fabrica.connect("setup", setup)
        fabrica.connect("bind", bind)
        tabela.append_column(Gtk.ColumnViewColumn(title=titulo, factory=fabrica,
                                                  expand=expandir, resizable=True))

    # -- estado ------------------------------------------------------------

    def itens(self):
        return [self.modelo.get_item(i) for i in range(self.modelo.get_n_items())]

    def selecionado(self):
        return self.selecao.get_selected_item()

    def set_ocupado(self, ocupado):
        self.ocupado = ocupado
        if ocupado:
            self.spinner.start()
        else:
            self.spinner.stop()
        self.atualizar_botoes()

    def atualizar_botoes(self):
        item = self.selecionado()
        pronto = self.status.get("config") == "yes" and not self.ocupado
        no_snapshot = bool(self.status.get("booted_snapshot"))
        self.botao_criar.set_sensitive(pronto and not no_snapshot)
        self.botao_apagar.set_sensitive(pronto and item is not None)
        self.botao_alteracoes.set_sensitive(pronto and item is not None
                                            and item.tipo in ("pre", "post"))
        self.botao_restaurar.set_sensitive(pronto and item is not None)

    def atualizar(self):
        self.set_ocupado(True)
        executar_async(["status"], False, self._ao_ler_status)

    def _ao_ler_status(self, rc, out, err):
        self.status = ler_status(out) if rc == 0 else {}
        self.atualizar_avisos()
        self.atualizar_status()
        if self.status.get("config") == "yes":
            executar_async(["list", "--csv"], False, self._ao_ler_lista)
        else:
            self.modelo.remove_all()
            self.set_ocupado(False)
        return False

    def _ao_ler_lista(self, rc, out, err):
        self.modelo.remove_all()
        self.set_ocupado(False)
        if rc != 0:
            msg = sem_ansi(err).strip() or "falha ao listar os snapshots"
            if "permiss" in msg.lower():
                msg += ("\n\nSeu usuário precisa estar no grupo wheel e o sistema "
                        "configurado (menu ☰ → Configurar sistema).")
            self.erro("Não foi possível listar os snapshots", msg)
            return False
        for item in ler_lista(out):
            self.modelo.append(item)
        return False

    def atualizar_avisos(self):
        st = self.status
        n = st.get("booted_snapshot")
        if n:
            self.label_boot.set_markup(
                f"⚠️ <b>O sistema foi iniciado a partir do snapshot {n}.</b>\n"
                "Para torná-lo o sistema principal, restaure-o.")
        self.caixa_boot.set_visible(bool(n))

        layout = st.get("layout")
        texto, botao = None, None
        if not st or layout == "nobtrfs":
            texto = "⚠️ O / não está em btrfs. Os snapshots não estão disponíveis."
        elif layout == "toplevel":
            texto = ("⚠️ O / está direto na raiz do btrfs, sem subvolumes.\n"
                     "É preciso converter para o layout @, @home, @snapshots (migrate).")
            botao = ("🧰 Migrar", "botao-laranja", self.ao_clicar_migrar)
        elif layout == "other":
            texto = "⚠️ Layout btrfs não suportado (esperado: @, @home, @snapshots)."
        elif layout == "flat" and st.get("migrate") == "pending":
            texto = ("🧹 A migração foi feita. Falta apagar o sistema antigo que ficou "
                     "na raiz do btrfs (migrate finish).")
            botao = ("🧹 Concluir migração", "botao-laranja", self.ao_clicar_migrar_finish)
        elif layout == "flat" and (st.get("config") != "yes" or st.get("wheel") != "yes"
                                   or ("grub" in st.get("bootloader", "")
                                       and st.get("grub_btrfs") != "active")):
            texto = "⚙️ O sistema ainda não está configurado para os snapshots."
            botao = ("⚙️ Configurar", "botao-azul", self.ao_clicar_configurar)
        if texto:
            self.label_setup.set_markup(texto)
            if botao:
                rotulo, classe, acao = botao
                self.botao_setup.set_label(rotulo)
                for c in ("botao-azul", "botao-laranja"):
                    self.botao_setup.remove_css_class(c)
                self.botao_setup.add_css_class(classe)
                self.acao_setup = acao
            self.botao_setup.set_visible(botao is not None)
        self.caixa_setup.set_visible(texto is not None)

    def atualizar_status(self):
        st = self.status
        if not st:
            self.label_status.set_text("❌ Não foi possível ler o estado do sistema.")
            return

        def ok(v):
            return "✅" if v else "❌"

        bl = st.get("bootloader", "unknown")
        partes = [
            f"📍 Sistema: {st.get('fsroot') or '-'}",
            f"{ok(st.get('config') == 'yes')} snapper",
            f"{ok(st.get('hooks') == 'yes')} hooks xbps",
        ]
        if "grub" in bl:
            partes.append({"active": "✅ grub-btrfs ativo", "inactive": "⚠️ grub-btrfs inativo",
                           "missing": "❌ grub-btrfs ausente"}.get(st.get("grub_btrfs", ""),
                                                                "❓ grub-btrfs"))
        if "limine" in bl:
            partes.append("✅ limine")
        if bl == "unknown":
            partes.append("❓ bootloader")
        partes += [
            f"💾 {st.get('disk_used', '?')} de {st.get('disk_size', '?')}",
        ]
        self.label_status.set_text("   •   ".join(partes))

    # -- diálogos ----------------------------------------------------------

    def erro(self, titulo, detalhe=""):
        d = Gtk.AlertDialog(message=f"❌ {titulo}", detail=detalhe, modal=True)
        d.show(self)

    def perguntar(self, titulo, detalhe, botao_ok, callback):
        d = Gtk.AlertDialog(message=titulo, detail=detalhe, modal=True,
                            buttons=["❌ Cancelar", botao_ok],
                            cancel_button=0, default_button=0)

        def resposta(dlg, res):
            try:
                if dlg.choose_finish(res) == 1:
                    callback()
            except GLib.Error:
                pass
        d.choose(self, None, resposta)

    def executar_root(self, args, ao_concluir, titulo_falha):
        self.set_ocupado(True)

        def fim(rc, out, err):
            self.set_ocupado(False)
            if rc == 0:
                ao_concluir(out)
            elif rc not in (126, 127):  # 126/127: autenticação cancelada no pkexec
                self.erro(titulo_falha, sem_ansi(err or out).strip())
            self.atualizar()
            return False
        executar_async(args, True, fim)

    def mostrar_texto(self, titulo, texto):
        janela = Gtk.Window(title=titulo, transient_for=self,
                            default_width=760, default_height=520)
        tv = Gtk.TextView(editable=False, monospace=True, cursor_visible=False,
                          left_margin=10, right_margin=10, top_margin=10, bottom_margin=10)
        tv.get_buffer().set_text(texto)
        rolagem = Gtk.ScrolledWindow()
        rolagem.set_child(tv)
        janela.set_child(rolagem)
        janela.present()

    # -- ações -------------------------------------------------------------

    def ao_clicar_criar(self, *_):
        dlg = Gtk.Window(title="Criar snapshot", transient_for=self, modal=True,
                         default_width=440)
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        caixa.append(Gtk.Label(label="📝 Descrição do snapshot:", xalign=0))
        entrada = Gtk.Entry(text="manual", activates_default=True)
        caixa.append(entrada)
        linha = Gtk.Box(spacing=8, homogeneous=True)
        cancelar = self._botao("❌ Cancelar", "botao-cinza", lambda *_: dlg.close())
        criar = Gtk.Button(label="➕ Criar")
        criar.add_css_class("botao-azul")
        linha.append(cancelar)
        linha.append(criar)
        caixa.append(linha)
        dlg.set_child(caixa)
        dlg.set_default_widget(criar)

        def confirmar(*_):
            desc = entrada.get_text().strip() or "manual"
            dlg.close()
            self.executar_root(["create", desc], lambda out: None, "Falha ao criar o snapshot")
        criar.connect("clicked", confirmar)
        dlg.present()

    def ao_clicar_apagar(self, *_):
        item = self.selecionado()
        if not item:
            return
        nums = {item.numero}
        # apagar um pre/post leva o par junto
        for outro in self.itens():
            if item.tipo == "pre" and outro.tipo == "post" and outro.pre == str(item.numero):
                nums.add(outro.numero)
            if item.tipo == "post" and item.pre and outro.numero == int(item.pre):
                nums.add(outro.numero)
        nums = [str(n) for n in sorted(nums)]
        self.perguntar(f"🗑️ Apagar o(s) snapshot(s) {', '.join(nums)}?",
                       f"{item.descricao}\n\nEsta ação não pode ser desfeita.", "🗑️ Apagar",
                       lambda: self.executar_root(["delete", *nums], lambda out: None,
                                                  "Falha ao apagar"))

    def ao_clicar_alteracoes(self, *_):
        item = self.selecionado()
        if not item or item.tipo not in ("pre", "post"):
            return
        pre = item.numero if item.tipo == "pre" else int(item.pre)
        self.set_ocupado(True)

        def fim(rc, out, err):
            self.set_ocupado(False)
            if rc != 0:
                self.erro("Não foi possível ver as alterações", sem_ansi(err).strip())
            else:
                self.mostrar_texto(f"🔍 Alterações do snapshot {pre}", sem_ansi(out))
            return False
        executar_async(["diff", str(pre)], False, fim)

    def ao_clicar_restaurar(self, *_):
        item = self.selecionado()
        if item:
            self.confirmar_restauracao(item.numero, item.descricao)

    def ao_clicar_restaurar_atual(self, *_):
        n = self.status.get("booted_snapshot")
        if n:
            desc = next((i.descricao for i in self.itens() if str(i.numero) == n), "")
            self.confirmar_restauracao(int(n), desc)

    def confirmar_restauracao(self, n, desc):
        extra = ""
        if not self.status.get("booted_snapshot"):
            extra = ("\n\n⚠️ Recomendado: iniciar primeiro no snapshot pelo menu do GRUB "
                     "e restaurar a partir dele.")
        self.perguntar(f"♻️ Restaurar o sistema para o snapshot {n}?",
                       f"{desc}\n\nO sistema atual será guardado como um novo snapshot "
                       f"(nada é apagado). Depois é preciso reiniciar.{extra}",
                       "♻️ Restaurar",
                       lambda: self.executar_root(["restore", str(n), "--yes"],
                                                  lambda out: self.perguntar_reinicio(n),
                                                  "Falha ao restaurar"))

    def perguntar_reinicio(self, n):
        self.perguntar(f"✅ Sistema restaurado para o snapshot {n}",
                       "Reinicie e escolha a entrada NORMAL do sistema no menu de boot.",
                       "🔁 Reiniciar agora",
                       lambda: subprocess.Popen(["pkexec", "reboot"]))

    def abrir_no_terminal(self, cmd):
        argv = comando_terminal(
            f"{cmd}; echo; printf 'Pressione Enter para fechar...'; read _")
        if not argv:
            self.erro("Nenhum terminal encontrado",
                      f"Abra um terminal e rode:\n\n{cmd}")
            return
        try:
            proc = subprocess.Popen(argv)
        except OSError as e:
            self.erro("Não foi possível abrir o terminal", str(e))
            return

        def esperar():
            proc.wait()
            GLib.idle_add(self.atualizar)
        threading.Thread(target=esperar, daemon=True).start()

    def ao_clicar_migrar(self, *_):
        self.perguntar("🧰 Migrar para o layout @, @home, @snapshots?",
                       "A migração abre num terminal, onde cada passo é mostrado e "
                       "confirmado. Ela reinstala o GRUB e pede para reiniciar.\n\n"
                       "⚠️ Faça um backup antes de continuar.",
                       "🧰 Abrir terminal",
                       lambda: self.abrir_no_terminal(
                           f"sudo {CLI} migrate"))

    def ao_clicar_migrar_finish(self, *_):
        self.perguntar("🧹 Concluir a migração?",
                       "Abre um terminal que lista e apaga o sistema antigo da raiz do "
                       "btrfs. O sistema atual (@) não é afetado.",
                       "🧹 Abrir terminal",
                       lambda: self.abrir_no_terminal(
                           f"sudo {CLI} migrate finish && sudo {CLI} setup"))

    def ao_clicar_configurar(self, *_):
        self.executar_root(["setup"],
                           lambda out: self.mostrar_texto("⚙️ Configuração", sem_ansi(out)),
                           "Falha na configuração")

    def ao_clicar_sobre(self, *_):
        sobre = Gtk.AboutDialog()
        sobre.set_transient_for(self)
        sobre.set_modal(True)
        sobre.set_program_name(APP_NAME)
        sobre.set_version(APP_VERSION)
        sobre.set_logo_icon_name("document-revert-symbolic")
        sobre.set_comments(
            "📸 Snapshots btrfs + snapper integrados ao xbps, feito com Python + GTK4.\n"
            "Desenvolvido para o VoidBR Linux 🐧"
        )
        sobre.set_website("https://voidbr.org")
        sobre.set_website_label("VoidBR")
        sobre.set_authors(["Vilmar Catafesta <vcatafesta@gmail.com>"])
        sobre.set_copyright("© 2026 Vilmar Catafesta — Licença livre, use e modifique à vontade")
        sobre.set_license_type(Gtk.License.MIT_X11)
        sobre.present()


class AppSnapperManager(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        janela = self.props.active_window or JanelaSnapperManager(self)
        janela.present()


if __name__ == "__main__":
    app = AppSnapperManager()
    app.run(None)
